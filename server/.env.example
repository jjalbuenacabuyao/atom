# Copy to .env and adjust. All values are read from the environment.
APP_ENV=development            # development | production | test
PORT=8080
DATABASE_URL=postgres://atom:atom@localhost:5432/atom?sslmode=disable
JWT_SECRET=                    # required in production, >= 32 chars (e.g. `openssl rand -base64 48`)
SESSION_TTL=168h
COOKIE_SECURE=false            # defaults to true in production
ALLOWED_ORIGINS=               # comma-separated; only needed if the SPA is served from another origin
TRUSTED_PROXIES=               # comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For
MIGRATE_ON_START=true
LOG_LEVEL=info
